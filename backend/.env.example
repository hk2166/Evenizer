# Server Configuration
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration (Neon Postgres)
# Use either NEON_DB_URI or DATABASE_URL.
NEON_DB_URI=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# JWT Configuration (we'll use this in Phase 2)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
